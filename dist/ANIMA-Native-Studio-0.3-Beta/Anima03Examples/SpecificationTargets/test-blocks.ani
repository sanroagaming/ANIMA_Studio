ANIMA 0.3

# SPECIFICATION TARGET — test blocks exist in the grammar; full test runner/native
# expect_fail and structured error matching are being completed later in the preview.
define clamp_hp(hp: whole, max_hp: whole) -> whole {
    when hp < 0 { give 0 }
    when hp > max_hp { give max_hp }
    give hp
}

test "clamps below zero" { expect_equal(clamp_hp(-5, 100), 0) }
test "clamps above max" { expect_equal(clamp_hp(500, 100), 100) }
